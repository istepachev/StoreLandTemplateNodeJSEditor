{
  "overrides": [
    {
      "files": "src/js/*.js",
      "options": {
        "trailingComma": "all",
        "printWidth": 80,
        "tabWidth": 2,
        "semi": true,
        "singleQuote": true,
        "quoteProps": "consistent"
      }
    },
    {
      "files": ["src/css/*.css"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
